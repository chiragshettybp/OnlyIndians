# Publicly safe - used in the browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SECRET - never commit, never expose in the browser.
# Only for server-side scripts / Edge Functions / SQL migrations.
# Keep this in .env.service-role and DO NOT prefix with VITE_ otherwise Vite
# will ship it to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key